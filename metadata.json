{
  "name": "Preflight",
  "tagline": "A shift-cover agent that checks before it acts.",
  "hackathon": "GenAI.works Open Agent Hackathon 2026",
  "track": "Track 3: Reasoning Architecture",
  "repository": "https://github.com/Shyboy0499/preflight",
  "language": "Python 3.12",
  "entrypoints": {
    "cli": "python -m app \"Ward 4B needs night cover tomorrow\"",
    "ui": "streamlit run ui/streamlit_app.py",
    "tests": "pytest"
  },
  "sample_mode": "SAMPLE_MODE=true runs the full demo with no credentials (DuckDB over synthetic CSVs, rule-based generator)",
  "sponsor_technology": {
    "zetaris": {
      "role": "Source of all facts and every precondition check (read-only SQL over the direct REST API)",
      "code": ["app/adapters/zetaris.py", "app/preconditions/checks.py", "app/preconditions/gate.py", "app/meterless/world_model.py"]
    },
    "meterless": {
      "engines": ["H-MEM", "World Model"],
      "code": ["app/meterless/hmem.py", "app/meterless/world_model.py", "app/adapters/llm.py"]
    },
    "llm": {
      "provider": "NVIDIA Nemotron via OpenAI-compatible endpoint (configurable)",
      "code": ["app/adapters/llm.py"]
    }
  },
  "data": "Synthetic only (data/sample/)",
  "logs": ["logs/trace.jsonl", "logs/decisions.jsonl", "logs/outbox.jsonl", "logs/hmem_ledger.jsonl"]
}
