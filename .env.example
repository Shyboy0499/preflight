# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Mode -------------------------------------------------------------------
# true: DuckDB over data/sample/<scenario>/*.csv + rule-based generator. No credentials needed.
SAMPLE_MODE=true
SAMPLE_SCENARIO=scenario_a
# Fixed "today" (YYYY-MM-DD). Sample mode defaults to 2026-10-26 (the data is anchored there).
# REQUIRED in live mode: 2026-10-26 for the demo data, or the real date for real data.
DEMO_TODAY=2026-10-26

# --- Zetaris (direct REST API, names match github.com/zetaris/getting-started) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_QUERY_LIMIT=1000
# Qualifier for the hospital tables in Lightning SQL, e.g. <source>.staff
ZETARIS_TABLE_PREFIX=preflight
ZETARIS_TIMEOUT_S=15

# --- LLM provider: Meterless Nightshift (primary) ---------------------------------
# Nightshift runs locally and routes requests; put your NVIDIA key inside Nightshift, not here.
# The runtime token is in <Nightshift stateDir>/proxy-token.
LLM_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=
METERLESS_MODEL=meterless/auto
LLM_TIMEOUT_S=180

# --- NVIDIA direct: documented fallback only (used if Nightshift fails) -------------
NVIDIA_API_KEY=
# Tested 2026-10-22: lightning gives valid JSON on every call, ~5 s per run. super/nano were not enabled for our account.
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Nemotron reasoning is off by default: these are short structured tasks, and with
# thinking on the reply can come back empty once reasoning uses up the token budget.
LLM_REASONING=false
LLM_MAX_TOKENS=2048
