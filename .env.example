# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- Mode -------------------------------------------------------------------
# true: DuckDB over data/sample/<scenario>/*.csv + rule-based generator. No credentials needed.
SAMPLE_MODE=true
SAMPLE_SCENARIO=scenario_a
# Fixed "today" (YYYY-MM-DD). Sample mode defaults to 2026-10-26 (the data is anchored there).
# REQUIRED in live mode: 2026-10-26 for the demo data, or the real date for real data.
DEMO_TODAY=2026-10-26

# --- Zetaris (direct REST API, names match github.com/zetaris/getting-started) ---
ZETARIS_BASE_URL=http://localhost:3000
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=
ZETARIS_API_KEY=
ZETARIS_QUERY_LIMIT=1000
# Qualifier for the hospital tables in Lightning SQL, e.g. <source>.staff
ZETARIS_TABLE_PREFIX=preflight
ZETARIS_TIMEOUT_S=15

# --- LLM generator (OpenAI-compatible; default NVIDIA Nemotron) ---------------
NVIDIA_API_KEY=
NVIDIA_MODEL=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_TIMEOUT_S=30
